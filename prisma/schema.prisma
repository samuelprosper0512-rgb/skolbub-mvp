generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id       String    @id @default(cuid())
  tenantId String    @unique
  slug     String    @unique
  name     String
  type     String    @default("SCHOOL")
  schoolType String  @default("secondary")
  ownership String  @default("private")
  primaryColor String @default("#1e40af")
  hasComputerLabs Boolean @default(false)
  enableCBT Boolean @default(true)
  enableOnlineClasses Boolean @default(false)
  motto String @default("")
  gradingSystem String @default("percentage")
  currency String @default("NGN")
  paymentCycle String @default("term")
  logoUrl String @default("")
  enableLibrary Boolean @default(false)
  enableTransport Boolean @default(false)
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  customDomain String? @unique
  users    User[]
  students Student[]
  exams    CBTExam[]
  fees     Fee[]
  results  Result[]
  staff    Staff[]
  announcements Announcement[]
  attendance Attendance[]
  messages Message[]
  timetables Timetable[]
  books Book[]
  bookLoans BookLoan[]
  busRoutes BusRoute[]
  studentRoutes StudentRoute[]
  behaviorLogs BehaviorLog[]
  healthRecords HealthRecord[]
  assignments Assignment[]
  submissions Submission[]
  transactions Transaction[]
  assets Asset[]
  hostels Hostel[]
  rooms Room[]
  roomAssignments RoomAssignment[]
  notifications Notification[]

  @@index([districtId])
}

model Staff {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  role      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  timetables Timetable[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Announcement {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model User {
  id           String @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         String @default("ADMIN")
  studentId    String?
  tenant       Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student      Student?
  parentStudent Student? @relation("ParentStudent", fields: [studentId], references: [id], onDelete: SetNull)
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  parentId     String?
  parent       User?    @relation("UserParent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children     User[]   @relation("UserParent")
  parentLinks  ParentStudent[] @relation("ParentStudentParent")
  notifications Notification[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, parentId])
}

model Student {
  id            String @id @default(cuid())
  tenantId      String
  name          String
  gradeLevel    String
  studentNumber String
  userId        String? @unique
  tenant        Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fees          Fee[]
  results       Result[]
  examResults   ExamResult[]
  parents       User[]   @relation("ParentStudent")
  parentLinks   ParentStudent[] @relation("ParentStudentStudent")
  submissions   Submission[]
  roomAssignment RoomAssignment?
  transactions  Transaction[]
  attendance    Attendance[]
  bookLoans     BookLoan[]
  studentRoute  StudentRoute?
  behaviorLogs  BehaviorLog[]
  healthRecord  HealthRecord?

  @@unique([tenantId, studentNumber])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model ParentStudent {
  id        String   @id @default(cuid())
  tenantId  String
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    User     @relation("ParentStudentParent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Cascade)
  student   Student  @relation("ParentStudentStudent", fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, parentId, studentId])
  @@index([tenantId, parentId])
  @@index([tenantId, studentId])
}

model Attendance {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student   Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId, date])
  @@index([tenantId, date])
}

model CBTExam {
  id         String     @id @default(cuid())
  tenantId   String
  title      String
  subject    String
  gradeLevel String
  duration   Int
  tenant     Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  questions  Question[]
  examResults ExamResult[]

  @@index([tenantId])
  @@unique([tenantId, id])
}

model ExamResult {
  id             String   @id @default(cuid())
  tenantId       String
  examId         String
  studentId      String
  score          Int
  totalQuestions Int
  createdAt      DateTime @default(now())
  exam           CBTExam  @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)
  student        Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, examId, studentId])
  @@index([tenantId, studentId])
}

model Question {
  id            String  @id @default(cuid())
  tenantId      String
  examId        String
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  exam          CBTExam @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)

}

model Fee {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  title     String
  amount    Int
  status    String   @default("unpaid")
  paystackReference String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student   Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([tenantId, id])
  @@index([tenantId, studentId])
}

model Result {
  id         String   @id @default(cuid())
  tenantId   String
  studentId  String
  subject    String
  term       String
  caScore    Int
  examScore  Int
  totalScore Int
  grade      String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student    Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId, subject, term])
  @@index([tenantId, studentId])
}

model Message {
  id         String   @id @default(cuid())
  tenantId   String
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([tenantId, receiverId, createdAt])
  @@index([tenantId, senderId, createdAt])
}

model Timetable {
  id         String   @id @default(cuid())
  tenantId   String
  gradeLevel String
  dayOfWeek  String
  period     String
  subject    String
  teacherId  String?
  tenant     Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  teacher    Staff?   @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, gradeLevel, dayOfWeek, period])
  @@index([tenantId, gradeLevel])
}

model Book {
  id        String     @id @default(cuid())
  tenantId  String
  title     String
  author    String
  isbn      String
  status    String     @default("available")
  tenant    Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  loans     BookLoan[]

  @@unique([tenantId, isbn])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model BookLoan {
  id        String    @id @default(cuid())
  tenantId  String
  bookId    String
  studentId String
  dueDate   DateTime
  returnedAt DateTime?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  book      Book     @relation(fields: [tenantId, bookId], references: [tenantId, id], onDelete: Cascade)
  student   Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, studentId, returnedAt])
}

model BusRoute {
  id         String          @id @default(cuid())
  tenantId   String
  name       String
  driverName String
  capacity   Int
  tenant     Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  students   StudentRoute[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model StudentRoute {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  routeId   String
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student   Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  route     BusRoute @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId])
  @@index([tenantId, routeId])
}

model BehaviorLog {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  type        String
  description String
  points      Int
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student     Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, studentId, createdAt])
}

model HealthRecord {
  id               String   @id @default(cuid())
  tenantId         String
  studentId        String
  bloodGroup       String   @default("")
  allergies        String   @default("")
  emergencyContact String   @default("")
  notes            String   @default("")
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student          Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId])
}

model Assignment {
  id          String       @id @default(cuid())
  tenantId    String
  subject     String
  gradeLevel  String
  title       String
  description String
  dueDate     DateTime
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  submissions Submission[]

  @@unique([tenantId, id])
  @@index([tenantId, gradeLevel, dueDate])
}

model Submission {
  id           String     @id @default(cuid())
  tenantId     String
  assignmentId String
  studentId    String
  content      String
  grade        String?
  submittedAt  DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  assignment   Assignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade)
  student      Student    @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, assignmentId, studentId])
  @@index([tenantId, studentId, submittedAt])
}

model Transaction {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  feeId       String   @unique
  amount      Int
  platformFee Int
  status      String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  student     Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  fee         Fee      @relation(fields: [tenantId, feeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
}

model Asset {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  category  String
  quantity  Int      @default(1)
  condition String
  location  String
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, category])
}

model Hostel {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  capacity  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  rooms     Room[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Room {
  id          String           @id @default(cuid())
  tenantId    String
  hostelId    String
  roomNumber  String
  capacity    Int
  tenant      Tenant           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  hostel      Hostel           @relation(fields: [tenantId, hostelId], references: [tenantId, id], onDelete: Cascade)
  assignments RoomAssignment[]

  @@unique([tenantId, hostelId, roomNumber])
  @@unique([tenantId, id])
  @@index([tenantId, hostelId])
}

model RoomAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  roomId    String
  studentId String
  assignedAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  room      Room     @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Cascade)
  student   Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId])
  @@index([tenantId, roomId])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user      User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId, isRead, createdAt])
}

model District {
  id      String   @id @default(cuid())
  name    String
  tenants Tenant[]

  @@unique([name])
}